# GridPulse needs no key for anything in v1.
# The optional F1 TV token (exact live car positions) is pasted in the control room, not here.

# Optional settings
# PORT=3000
# HOST=0.0.0.0       # allow other devices on your network, such as a phone
# DATA_DIR=          # defaults to ./data
# CONTROL_TOKEN=     # generated and saved in data/tokens.json if not set
# OVERLAY_TOKEN=     # generated and saved in data/tokens.json if not set
